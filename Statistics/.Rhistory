(-0.50) * (treatment == "NewDrug") +
0.05 * (crp - 5)
base_rate <- 0.08
true_rate <- base_rate * exp(lp)
true_event_time <- rexp(n, rate = true_rate)
random_censor <- runif(n, min = 5, max = 30)
admin_censor <- rep(36, n)
obs_time <- pmin(true_event_time, random_censor, admin_censor)
status <- as.integer(true_event_time <= pmin(random_censor, admin_censor))
health_dat <- data.frame(
id = seq_len(n),
time_months = round(obs_time, 2),
event = status,
age = age,
sex = sex,
diabetes = diabetes,
stage = stage,
treatment = treatment,
crp = crp
)
View(health_dat)
km_fit <- survfit(Surv(time_months, event) ~ treatment, data = health_dat)
print(summary(km_fit, times = c(6, 12, 24, 36))$table)
exp_fit <- survreg(
Surv(time_months, event) ~ age + sex + diabetes + stage + treatment + crp,
data = health_dat,
dist = "exponential"
)
print(summary(exp_fit))
coef_aft <- coef(exp_fit)
hr <- exp(-coef_aft)
hr_table <- data.frame(
term = names(hr),
hazard_ratio = as.numeric(hr),
row.names = NULL
)
View(hr_table)
new_profiles <- data.frame(
age = c(50, 65, 65),
sex = factor(c("Female", "Male", "Male"), levels = levels(health_dat$sex)),
diabetes = factor(c("No", "No", "Yes"), levels = levels(health_dat$diabetes)),
stage = factor(c("I", "II", "III"), levels = levels(health_dat$stage)),
treatment = factor(c("NewDrug", "Standard", "Standard"), levels = levels(health_dat$treatment)),
crp = c(4.5, 6.5, 9.0)
)
View(new_profiles)
lp_profiles <- predict(exp_fit, newdata = new_profiles, type = "lp")
rate_profiles <- exp(-lp_profiles)
med_profiles <- log(2) / rate_profiles
pred_table <- cbind(new_profiles, hazard_rate = round(rate_profiles, 4), median_survival_months = round(med_profiles, 2))
cat("\n--- Predicted hazard and median survival for clinical profiles ---\n")
print(pred_table)
na_fit <- survfit(Surv(time_months, event) ~ 1, data = health_dat, type = "fleming-harrington")
na_df <- data.frame(time = na_fit$time, cumhaz = na_fit$cumhaz)
lin_na <- lm(cumhaz ~ 0 + time, data = na_df)
cat("Nelson-Aalen cumulative hazard ~ time through origin\n")
print(summary(lin_na))
cat("Interpretation: Exponential implies near-linear cumhaz vs time and high R^2.\n")
weibull_fit <- survreg(
Surv(time_months, event) ~ age + sex + diabetes + stage + treatment + crp,
data = health_dat,
dist = "weibull"
)
shape_weibull <- 1 / weibull_fit$scale
se_logscale <- sqrt(vcov(weibull_fit)["Log(scale)", "Log(scale)"])
logscale_ci <- log(weibull_fit$scale) + c(-1, 1) * 1.96 * se_logscale
scale_ci <- exp(logscale_ci)
shape_ci <- rev(1 / scale_ci)
cat("\nWeibull shape estimate (shape = 1/scale):", round(shape_weibull, 3), "\n")
cat("95% CI for shape:", paste(round(shape_ci, 3), collapse = " to "), "\n")
cat("Interpretation: shape near 1 supports exponential baseline hazard.\n")
ll_exp <- as.numeric(logLik(exp_fit))
ll_wei <- as.numeric(logLik(weibull_fit))
aic_exp <- AIC(exp_fit)
aic_wei <- AIC(weibull_fit)
cat("\nLogLik Exponential:", round(ll_exp, 2), "| AIC Exponential:", round(aic_exp, 2), "\n")
cat("LogLik Weibull:", round(ll_wei, 2), "| AIC Weibull:", round(aic_wei, 2), "\n")
cat("Interpretation: If Weibull materially improves AIC/logLik, constant hazard may be too restrictive.\n")
coxsnell <- -log(
pmax(
pmin(
1 - pexp(health_dat$time_months, rate = exp(-predict(exp_fit, type = "lp"))),
1 - 1e-12
),
1e-12
)
)
ks_out <- ks.test(coxsnell, "pexp", 1)
cat("\nCox-Snell residual KS test against Exp(1):\n")
print(ks_out)
cat("Interpretation: Larger p-value indicates residuals are compatible with Exp(1).\n")
cox_ref <- coxph(Surv(time_months, event) ~ age + sex + diabetes + stage + treatment + crp, data = health_dat)
ph_test <- cox.zph(cox_ref)
cat("\nCox PH assumption check (reference model):\n")
print(ph_test)
cat("Interpretation: Strong PH violations suggest caution when translating exponential PH assumptions.\n")
cat("\n--- Practical usage guidance ---\n")
cat(
"1) Exponential model is useful when hazard is approximately constant over follow-up.\n",
"2) Use it for fast baseline risk scoring and quick what-if scenario comparisons.\n",
"3) Re-check fit whenever time horizon, treatment standards, or population case-mix changes.\n",
"4) If checks fail, move to Weibull, piecewise-exponential, or Cox model.\n",
sep = ""
)
if (interactive()) {
old_par <- par(no.readonly = TRUE)
on.exit(par(old_par), add = TRUE)
par(mfrow = c(2, 2))
plot(km_fit, col = c("#b22222", "#1f78b4"), lwd = 2,
xlab = "Months", ylab = "Survival", main = "KM by Treatment")
legend("topright", legend = levels(health_dat$treatment), col = c("#b22222", "#1f78b4"), lwd = 2, bty = "n")
plot(na_df$time, na_df$cumhaz, pch = 16, cex = 0.5,
xlab = "Months", ylab = "Cumulative hazard", main = "Nelson-Aalen")
abline(lin_na, col = "#b22222", lwd = 2)
qqplot(qexp(ppoints(length(coxsnell))), sort(coxsnell), pch = 16, cex = 0.6,
xlab = "Theoretical Exp(1)", ylab = "Observed Cox-Snell", main = "Residual QQ")
abline(0, 1, col = "#b22222", lwd = 2)
hist(coxsnell, breaks = 30, col = "#d9d9d9", border = "white",
main = "Cox-Snell Residuals", xlab = "Residual")
}
